# ChromaDB
YAPA_CHROMA_URL=http://localhost:8000

# Username (used for task ID prefixes)
YAPA_USERNAME=your-username

# Embedding provider: chromadb (default, zero-config), fireworks, openai, voyage, ollama
YAPA_EMBEDDING_PROVIDER=chromadb

# Fireworks (if YAPA_EMBEDDING_PROVIDER=fireworks)
# YAPA_FIREWORKS_API_KEY=fw-...
# YAPA_EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1

# OpenAI (if YAPA_EMBEDDING_PROVIDER=openai)
# YAPA_OPENAI_API_KEY=sk-...
# YAPA_EMBEDDING_MODEL=text-embedding-3-small

# Voyage AI (if YAPA_EMBEDDING_PROVIDER=voyage)
# YAPA_VOYAGE_API_KEY=pa-...
# YAPA_EMBEDDING_MODEL=voyage-3-lite

# Ollama (if YAPA_EMBEDDING_PROVIDER=ollama)
# YAPA_OLLAMA_URL=http://localhost:11434
# YAPA_EMBEDDING_MODEL=nomic-embed-text

# Lifecycle
# YAPA_SALIENCE_DECAY_RATE=0.98
