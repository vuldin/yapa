# ChromaDB
YAPA_CHROMA_URL=http://localhost:8000

# Username (used for task ID prefixes)
YAPA_USERNAME=your-username

# Embedding provider: chromadb (default, zero-config), fireworks, openai, voyage, ollama
YAPA_EMBEDDING_PROVIDER=chromadb

# Fireworks (if YAPA_EMBEDDING_PROVIDER=fireworks)
# YAPA_FIREWORKS_API_KEY=fw-...
# YAPA_EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1

# OpenAI (if YAPA_EMBEDDING_PROVIDER=openai)
# YAPA_OPENAI_API_KEY=sk-...
# YAPA_EMBEDDING_MODEL=text-embedding-3-small

# Voyage AI (if YAPA_EMBEDDING_PROVIDER=voyage)
# YAPA_VOYAGE_API_KEY=pa-...
# YAPA_EMBEDDING_MODEL=voyage-3-lite

# Ollama (if YAPA_EMBEDDING_PROVIDER=ollama)
# YAPA_OLLAMA_URL=http://localhost:11434
# YAPA_EMBEDDING_MODEL=nomic-embed-text

# Lifecycle
# YAPA_SALIENCE_DECAY_RATE=0.98
# YAPA_SALIENCE_RANKING_WEIGHT=0.3

# Curation (optional — classifier that scores memories for trainable / durability / generalizability)
# YAPA_CURATION_ENABLED=true
# YAPA_CURATION_INTERVAL_MS=604800000
# YAPA_CURATION_LLM_PROVIDER=anthropic
# YAPA_CURATION_MODEL=
# YAPA_CURATION_BATCH_SIZE=20
# YAPA_ANTHROPIC_API_KEY=sk-ant-...

# Bucket routing (defaults shown — tune after first classifier runs)
# YAPA_ARTIFACTS_DIR=~/.yapa/artifacts
# YAPA_SYSTEM_PROMPT_TRAINABLE_MIN=0.5
# YAPA_SYSTEM_PROMPT_DURABILITY_MIN=0.7
# YAPA_SYSTEM_PROMPT_GENERALIZABILITY_MIN=0.5
# YAPA_TRAINING_TRAINABLE_MIN=0.7
# YAPA_TRAINING_DURABILITY_MIN=0.8
# YAPA_TRAINING_GENERALIZABILITY_MIN=0.7

# Training (Fireworks via firectl)
# YAPA_TRAINING_BACKEND=fireworks
# YAPA_TRAINING_BASE_MODEL=accounts/fireworks/models/qwen3-coder-30b-a3b-instruct
# YAPA_TRAINING_FIRECTL_PATH=firectl
# YAPA_TRAINING_SYNTHESIS_MODEL=

# Eval + per-memory verification (Phase 4). Verification incurs adapter inference cost,
# so it is opt-in.
# YAPA_VERIFICATION_ENABLED=false
# YAPA_EVAL_HOLDOUT_FRACTION=0.15
# YAPA_EVAL_HOLDOUT_MIN=3
# YAPA_INFERENCE_BASE_URL=https://api.fireworks.ai/inference/v1

# Remote sync (optional — requires PostgreSQL with pgvector)
# YAPA_SYNC_ENABLED=true
# YAPA_SYNC_DATABASE_URL=postgres://user:pass@host:5432/yapa
# YAPA_SYNC_INTERVAL_MS=300000
# YAPA_SYNC_SIMILARITY_THRESHOLD=0.95
