{
  "name": "yapa-mcp",
  "version": "1.0.0",
  "description": "YAPA — Memory & Task MCP Server backed by ChromaDB",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "yapa-mcp": "dist/index.js",
    "yapa": "dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@yapa/core": "^1.0.0",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
