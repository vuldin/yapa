{
  "name": "yapa",
  "version": "1.1.0",
  "description": "YAPA \u2014 Memory & Task assistant: core library, MCP server, and DeepSeek Harness plugin",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/dsh",
    "packages/mcp",
    "packages/service",
    "packages/mcp-remote"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev --workspaces --if-present",
    "pretest": "npm run build",
    "test": "npm run test --workspaces --if-present",
    "start": "node packages/mcp/dist/index.js",
    "build:plugin": "node scripts/build-plugin.mjs",
    "build:all": "npm run build && npm run build:plugin",
    "test:service": "npm test -w packages/service",
    "test:service:integration": "npm run test:integration -w packages/service",
    "test:mcp-remote": "npm test -w packages/mcp-remote",
    "test:mcp-remote:integration": "npm run test:integration -w packages/mcp-remote"
  },
  "devDependencies": {
    "@types/node": "^25.9.9",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
